# Collab Studio — copy to collab_studio/.env (git-ignored) and fill in what you have.
# Everything is optional for local development: without it you get demo images, a simulated
# test checkout, and email previews in /admin/emails.

# ── Core ────────────────────────────────────────────────────────────────────────────────
COLLAB_BASE_URL=http://127.0.0.1:8470        # used in email links; https://… enables secure cookies
COLLAB_ADMIN_PASSWORD=                         # blank = random one saved to data/collab_studio/admin_password.txt
COLLAB_SECRET_KEY=                             # blank = random one saved to data/collab_studio/secret_key.txt
# COLLAB_DATA_DIR=data/collab_studio           # database + uploaded/generated images
# COLLAB_RUN_WORKER=1                          # background design worker in the web process

# ── Image generation: demo | codex | openai ─────────────────────────────────────────────
COLLAB_IMAGE_PROVIDER=demo
# codex: uses the Codex CLI signed in with ChatGPT on this machine (no key stored here)
# openai: needs a server-side API key
OPENAI_API_KEY=
COLLAB_OPENAI_IMAGE_MODEL=gpt-image-1

# ── Payments: simulated | stripe ────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty for the simulated test checkout. Use a TEST key (sk_test_…);
# live keys are refused unless COLLAB_ALLOW_LIVE_PAYMENTS=1.
COLLAB_PAYMENT_PROVIDER=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                         # whsec_… for POST /webhooks/stripe
# COLLAB_ALLOW_LIVE_PAYMENTS=0

# ── Email: preview | smtp ───────────────────────────────────────────────────────────────
COLLAB_EMAIL_PROVIDER=preview
COLLAB_EMAIL_FROM=Collab Studio <studio@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Fulfillment: manual | printify ──────────────────────────────────────────────────────
COLLAB_FULFILLMENT_PROVIDER=manual
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
